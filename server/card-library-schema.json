{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "Schema for validating Dominion-style cards",
  "type": "object",
  "additionalProperties": {
    "oneOf": [
      { "$ref": "#/$defs/Card" },
      { "$ref": "#/$defs/RandomizerPile" }
    ]
  },
  "$defs": {
    "CardType": {
      "type": "string",
      "enum": [
        "ACTION",
        "ALLY",
        "ARTIFACT",
        "ATTACK",
        "AUGUR",
        "BOON",
        "CASTLE",
        "CLASH",
        "COMMAND",
        "CURSE",
        "DOOM",
        "DURATION",
        "EVENT",
        "FATE",
        "FORT",
        "HEIRLOOM",
        "HEX",
        "KNIGHT",
        "LANDMARK",
        "LIAISON",
        "LOOT",
        "LOOTER",
        "NIGHT",
        "ODYSSEY",
        "OMEN",
        "PRIZE",
        "PROJECT",
        "PROPHECY",
        "REACTION",
        "RESERVE",
        "REWARD",
        "RUINS",
        "SHADOW",
        "SHELTER",
        "SPIRIT",
        "STATE",
        "TOWNSFOLK",
        "TRAIT",
        "TRAVELLER",
        "TREASURE",
        "VICTORY",
        "WAY",
        "WIZARD",
        "ZOMBIE"
      ]
    },
    "RandomizerPile": {
      "type": "object",
      "description": "Defines a split/variant pile with shared pile metadata and individual card entries.",
      "properties": {
        "pile": {
          "type": "object",
          "description": "Pile-level metadata used for selection and pile-based effects.",
          "properties": {
            "randomizer": {
              "type": "string",
              "description": "Randomizer key for the pile."
            },
            "cost": {
              "type": "object",
              "description": "Pile-level cost used for pile-based effects or selection.",
              "properties": {
                "treasure": {
                  "type": "integer",
                  "minimum": 0
                },
                "potion": {
                  "type": "integer",
                  "minimum": 1
                },
                "debt": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": ["treasure"],
              "additionalProperties": false
            },
            "type": {
              "type": "array",
              "description": "Pile-level types used for pile-based effects or selection.",
              "items": {
                "$ref": "#/$defs/CardType"
              },
              "uniqueItems": true
            }
          },
          "additionalProperties": false
        },
        "cards": {
          "type": "array",
          "minItems": 1,
          "description": "List of distinct card definitions that make up the pile.",
          "items": {
            "$ref": "#/$defs/PileCard"
          }
        }
      },
      "required": ["pile", "cards"],
      "additionalProperties": false
    },
    "PileCard": {
      "type": "object",
      "description": "Card definition entry used inside a randomizer pile.",
      "properties": {
        "cardKey": {
          "type": "string",
          "description": "Unique card key for the card within the pile."
        },
        "kingdomSelectable": {
          "type": "boolean",
          "description": "Indicates whether the card is eligible for kingdom selection."
        },
        "victoryPoints": {
          "type": "integer",
          "description": "Number of 'static' victory points the card is worth."
        },
        "tags": {
          "description": "A list of tags applied to the object, can be used for filter operations.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cost": {
          "type": "object",
          "description": "Card cost in treasure/potion/debt.",
          "properties": {
            "treasure": {
              "type": "integer",
              "minimum": 0
            },
            "potion": {
              "type": "integer",
              "minimum": 1
            },
            "debt": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": ["treasure"],
          "additionalProperties": false
        },
        "mat": {
          "type": "string",
          "description": "Indicates the card requires a mat to be used."
        },
        "isBasic": {
          "type": "boolean",
          "description": "Indicates the card is a basic supply card (not a kingdom card)."
        },
        "cardName": {
          "type": "string",
          "description": "The human-readable card name. If not defined, the card's key is capitalized and used as the card name."
        },
        "type": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CardType"
          },
          "uniqueItems": true,
          "description": "Defines the type(s) of the card (e.g., TREASURE, VICTORY, ACTION)."
        },
        "targetScheme": {
          "type": "string",
          "enum": ["ALL_OTHER", "ALL"],
          "description": "Required for ATTACK cards to specify the target pattern."
        },
        "abilityText": {
          "type": "string",
          "description": "The text to display on the card."
        }
      },
      "required": ["cardKey", "cost", "type"],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "contains": {
                  "const": "ATTACK"
                }
              }
            }
          },
          "then": {
            "required": ["targetScheme"]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "contains": {
                  "const": "VICTORY"
                }
              }
            }
          },
          "then": {
            "required": ["victoryPoints"]
          }
        }
      ]
    },
    "Card": {
      "type": "object",
      "description": "Standard single-card definition entry.",
      "properties": {
        "kingdom": {
          "type": "string",
          "description": "Pile/kingdom name used to group cards into a supply pile."
        },
        "kingdomSelectable": {
          "type": "boolean",
          "description": "Indicates whether the card is eligible for kingdom selection."
        },
        "victoryPoints": {
          "type": "integer",
          "description": "Number of 'static' victory points the card is worth."
        },
        "tags": {
          "description": "A list of tags applied to the object, can be used for filter operations.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cost": {
          "type": "object",
          "description": "Card cost in treasure/potion/debt.",
          "properties": {
            "treasure": {
              "type": "integer",
              "minimum": 0
            },
            "potion": {
              "type": "integer",
              "minimum": 1
            },
            "debt": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": ["treasure"],
          "additionalProperties": false
        },
        "mat": {
          "type": "string",
          "description": "Indicates the card requires a mat to be used."
        },
        "isBasic": {
          "type": "boolean",
          "description": "Indicates the card is a basic supply card (not a kingdom card)."
        },
        "cardName": {
          "type": "string",
          "description": "The human-readable card name. If not defined, the card's key is capitalized and used as the card name."
        },
        "type": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CardType"
          },
          "uniqueItems": true,
          "description": "Defines the type(s) of the card (e.g., TREASURE, VICTORY, ACTION)."
        },
        "targetScheme": {
          "type": "string",
          "enum": ["ALL_OTHER", "ALL"],
          "description": "Required for ATTACK cards to specify the target pattern."
        },
        "abilityText": {
          "type": "string",
          "description": "The text to display on the card."
        }
      },
      "required": ["cost", "type"],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "contains": {
                  "const": "ATTACK"
                }
              }
            }
          },
          "then": {
            "required": ["targetScheme"]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "contains": {
                  "const": "VICTORY"
                }
              }
            }
          },
          "then": {
            "required": ["victoryPoints"]
          }
        }
      ]
    }
  }
}
