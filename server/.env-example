#port the game server runs on
PORT=3001
LOG_TO_FILE=true
LOG_FILE_MAX_BYTES=5242880
GAME_DATA_ROOT=./game-data
MATCH_STATE_EXPORT_ENABLED=true
END_MATCH_ON_NO_HUMANS=true
LOG_COLOR=true
MATCH_STATE_MERGE_ENABLED=true
# Optional client UI tuning: default delay before closing tooltips/popovers (ms).
TOOLTIP_DEFAULT_CLOSE_DELAY_MS=160
# Preset password for simple authentication. Required unless AUTH_DISABLED=true.
AUTH_PASSWORD=dominion
# Set to 'true' to disable password checking entirely (development only).
AUTH_DISABLED=false
# Comma-separated origin allowlist for /auth/* CORS. Use '*' for any origin (dev only).
AUTH_ALLOWED_ORIGINS=http://localhost:51455,http://localhost:4200
# Failed-login rate limit (per client IP).
AUTH_RATE_LIMIT_MAX_ATTEMPTS=10
AUTH_RATE_LIMIT_WINDOW_MS=60000
# Max body size (bytes) accepted by /auth/login.
AUTH_MAX_BODY_BYTES=4096
# Session time-to-live in milliseconds (sliding window). Default: 7 days.
AUTH_SESSION_TTL_MS=604800000
# Session storage backend: 'memory' (default, lost on restart), 'sqlite' (persistent), or 'kv' (Deno KV, persistent).
AUTH_SESSION_STORE=memory
# Filesystem path to the SQLite database file (used when AUTH_SESSION_STORE=sqlite).
AUTH_DB_PATH=./game-data/auth.sqlite
# Filesystem path to the Deno KV store file (used when AUTH_SESSION_STORE=kv).
# Use ':memory:' for an in-process store (dev/test only — data is not persisted).
AUTH_KV_PATH=./game-data/auth.kv
