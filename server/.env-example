#port the game server runs on
PORT=3001
LOG_TO_FILE=true
LOG_FILE_MAX_BYTES=5242880
GAME_DATA_ROOT=./game-data
MATCH_STATE_EXPORT_ENABLED=true
END_MATCH_ON_NO_HUMANS=true
LOG_COLOR=true
MATCH_STATE_MERGE_ENABLED=true
# Optional client UI tuning: default delay before closing tooltips/popovers (ms).
TOOLTIP_DEFAULT_CLOSE_DELAY_MS=160

## Storage backend

# Storage backend. Allowed values: 'in-memory' (no persistence) or 'supabase'.
# When unset, the server starts but /status reports a STORAGE_BACKEND_INVALID error.
STORAGE_BACKEND=in-memory

# Required when STORAGE_BACKEND=supabase.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

## Authentication

# Comma-separated origin allowlist for /auth/* CORS. Use '*' for any origin (dev only).
AUTH_ALLOWED_ORIGINS=http://localhost:51455,http://localhost:4200

# Failed-login rate limit (per client IP).
AUTH_RATE_LIMIT_MAX_ATTEMPTS=10
AUTH_RATE_LIMIT_WINDOW_MS=60000

# Max body size (bytes) accepted by /auth/login.
AUTH_MAX_BODY_BYTES=4096

# Session time-to-live in milliseconds (sliding window). Default: 7 days.
AUTH_SESSION_TTL_MS=604800000

## Multi-user accounts

# Consecutive failed logins before a user account is locked (per-account,
# independent of the per-IP rate limiter). Default: 5.
AUTH_LOCKOUT_THRESHOLD=5

# Lockout duration (milliseconds) once the threshold is hit. Default: 10 minutes.
AUTH_LOCKOUT_DURATION_MS=600000

# Minimum password length enforced at registration and password-change. Default: 10.
AUTH_MIN_PASSWORD_LENGTH=10

## Local development auth bypass

# DANGER — local development ONLY. When 'true', the server accepts ANY non-empty
# username/password combination, bypassing password verification and the user
# store, and treats the login as an admin. Removes login friction during local
# development. Defaults to 'false'. NEVER enable in a shared or production
# environment. The server logs a prominent warning at startup when this is on.
AUTH_DEV_BYPASS=false
