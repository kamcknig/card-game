{
  "compilerOptions": {
    "lib": [
      "es2023",
      "dom",
      "deno.ns",
      "deno.unstable"
    ],
    "types": [
      "npm:@types/jest@^30.0.0"
    ]
  },
  "version": "1.0.0",
  "nodeModulesDir": "manual",
  "tasks": {
    "dev:watch": "deno run --inspect --check --env-file --allow-sys --allow-read --allow-write --allow-net --allow-env --allow-ffi --unstable-ffi --watch src/server.ts",
    "auth:users": "deno run --allow-env --allow-read --allow-write --allow-ffi --allow-net scripts/auth-user-mgmt.ts",
    "auth:create-reg-code": "deno run --allow-env --allow-read --allow-write scripts/auth-create-reg-code.ts",
    "fmt": "oxfmt --write src/",
    "test:unit": "deno test --allow-env --allow-write --allow-read --allow-sys=cpus --allow-ffi --unstable-ffi src/",
    "test:unit:watch": "deno test --allow-write --allow-env --allow-read --allow-sys=cpus --allow-ffi --unstable-ffi --watch src/",
    "test:unit:coverage": "deno test --allow-write --allow-env --allow-read --allow-sys=cpus --allow-ffi --unstable-ffi --clean --coverage=coverage src/ && deno coverage coverage --exclude=src/testing/ --lcov --output=coverage/lcov.info && deno coverage coverage --exclude=src/testing/ --html"
  },
  "test": {
    "exclude": [
      "src/testing/"
    ]
  },
  "lint": {
    "include": [
      "src/"
    ],
    "rules": {
      "tags": [
        "recommended"
      ],
      "exclude": [
        "require-await",
        "no-unused-vars"
      ]
    }
  },
  "fmt": {
    "singleQuote": true,
    "indentWidth": 2,
    "useTabs": false,
    "lineWidth": 120,
    "proseWrap": "always",
    "semiColons": true
  },
  "lint-staged": {
    "*": "oxfmt --no-error-on-unmatched-pattern"
  },
  "imports": {
    "@shared/": "../shared/src/",
    "@server-types/": "./src/type-groups/",
    "@expansions/": "./src/expansions/",
    "@denosaurs/event": "jsr:@denosaurs/event@^2.0.2",
    "@timepp/enhanced-deno-log": "jsr:@timepp/enhanced-deno-log@^0.4.2",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/path": "jsr:@std/path@^1.1.4",
    "@types/jest": "npm:@types/jest@^30.0.0",
    "es-toolkit": "jsr:@es-toolkit/es-toolkit@^1.46.1",
    "fast-json-patch": "npm:fast-json-patch@3.1.1",
    "jest": "npm:jest@^30.3.0",
    "lint-staged": "npm:lint-staged@^16.4.0",
    "lodash-es": "npm:lodash-es@4.18.1",
    "nanostores": "npm:nanostores@1.3.0",
    "shared/types/": "../shared/src/types/",
    "socket.io": "https://deno.land/x/socket_io@0.2.1/mod.ts",
    "fuse.js": "npm:fuse.js@7.3.0",
    "awilix": "npm:awilix@13.0.3",
    "bcrypt": "https://deno.land/x/bcrypt@v0.4.1/mod.ts",
    "@rabbit-company/argon2id": "jsr:@rabbit-company/argon2id@^2.1.0",
    "@supabase/supabase-js": "npm:@supabase/supabase-js@^2.105.1"
  },
  "allowScripts": [
    "npm:esbuild@0.25.1",
    "npm:unrs-resolver@1.11.1"
  ]
}
