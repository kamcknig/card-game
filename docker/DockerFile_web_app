# --- Build Stage ---
FROM node:24-alpine AS build

WORKDIR /app

# install shared dependencies
COPY shared/package.json shared/yarn.lock ./shared/
RUN cd shared && yarn install --frozen-lockfile
COPY shared/ ./shared/

# install web app dependencies
COPY angular-frontend/package.json angular-frontend/yarn.lock ./angular-frontend/
RUN cd angular-frontend && yarn install --frozen-lockfile
COPY angular-frontend/ ./angular-frontend/

# build the angular app
ARG BUILD_CONFIG=production
RUN cd angular-frontend && yarn ng build --configuration=$BUILD_CONFIG

# --- Serve Stage ---
FROM nginx:alpine

COPY --from=build /app/angular-frontend/dist/angular-frontend/browser /usr/share/nginx/html/
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

# Static env.js — Angular reads window.__env.wsHost at runtime. Empty
# string makes the bundle issue relative requests, which nginx proxies
# to the server container. No per-environment templating needed.
RUN printf 'window.__env = { wsHost: "" };\n' > /usr/share/nginx/html/env.js

EXPOSE 80
